[user]
	email = georg@python.org
	name = Georg Brandl
[core]
	pager = less -SFXR
	attributesfile = /home/gbrandl/.gitattributes
[color]
	diff = auto
	status = auto
	branch = auto
	remote = auto
	ui = true
[alias]
	co = checkout
	ci = commit
	st = status
	br = branch
	ds = !git-diff-highlight --staged
	rb = rebase -i origin/master
	ca = commit --amend
	pg = push gerrit
	ann = blame
	rev = checkout --
	lg = log --graph
	df = !git-diff-highlight
	sh = !git-diff-highlight --show
	newtag = !"f() { git tag -a -m \"\" \"$@\"; git push --tags; }; f"
	rmtag = !"f() { git tag -d $1; git push origin :refs/tags/$1; }; f"
	retag = !"f() { git rmtag $1; git newtag \"$@\"; }; f"
	pfusch = push
	pfush = push
[push]
	default = simple
[pull]
	rebase = true
[branch]
	autosetuprebase = remote
[log]
	decorate = short
[rebase]
	autosquash = true
	autostash = true
[merge]
	defaultToUpstream = true
	conflictstyle = diff3
[core]
	pager = less -SFXR
	attributesfile = /home/gbrandl/.gitattributes
[pager]
        diff = delta --light -ns
        log = delta --light -ns
        reflog = delta --light -ns
        show = delta --light -ns
[interactive]
        diffFilter = delta --light -ns --color-only --features=interactive
[init]
	templatedir = /home/gbr/.git_template
	defaultBranch = master
[transfer]
	fsckObjects = true
[diff]
	renameLimit = 5000
[http]
	sslverify = false
[advice]
	detachedHead = false
	skippedCherryPicks = false
[diff "json"]
	textconv = jq --sort-keys .
[commit]
	verbose = true
[diff "rom"]
	textconv = hexdump -v -C
[receive]
	denyCurrentBranch = off
[safe]
	directory = /share/ictrlfs/public/spec
